# Analog Stereo
# Warm interlocking echoes with a 4:3 stereo pulse pattern.
# Dotted eighth notes on the left and quarter notes on the right, with separate analog feedback paths.
sync_mode=internal
tempo_bpm=120
division=1/8D
right_division=1/4
model=analog
feedback=0.13
mix=0.39
tone_hz=3000
drive=0.428
bit_depth=8
mod_rate_hz=1
mod_depth_ms=0
duck_threshold_db=-24
duck_amount=0.9
attack_ms=5
release_ms=250
swell_ms=250
stereo_ratio=1.33
loop_action=record
limiter_enabled=1
limiter_ceiling=0.891250938
limiter_release_ms=150
sample_rate_hz=8000
exciter_amount=0.1
exciter_tune_hz=4000
tap_pattern=0
mod1_source=0
mod1_destination=0
mod1_amount=0
mod2_source=0
mod2_destination=0
mod2_amount=0
feedback_lowpass_hz=12000
drift_amount=0
feedback_highpass_hz=80
lores_rate_end_hz=1200
lores_rate_decay_ms=1500
lores_rate_envelope_amount=1
digital_rack_rate_hz=16000
lores_cutoff_hz=2000
voicing=a04
modulation_enabled=0
exciter_highpass_enabled=0
wet_tone_enabled=0
stereo_timing_enabled=1

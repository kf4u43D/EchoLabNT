# Bloom
# A fully wet swell for soft entrances and pads.
# A rising wet envelope with short sixteenth-note echoes; the stored tail is released after the phrase.
sync_mode=internal
tempo_bpm=120
division=1/16
right_division=ratio
model=autovolume
feedback=0.22
mix=1
tone_hz=4400
drive=0
bit_depth=8
mod_rate_hz=1
mod_depth_ms=6
duck_threshold_db=-40
duck_amount=0.9
attack_ms=2
release_ms=500
swell_ms=600
stereo_ratio=1.5
loop_action=record
limiter_enabled=1
limiter_ceiling=0.891250938
limiter_release_ms=150
sample_rate_hz=8000
exciter_amount=0.1
exciter_tune_hz=4000
tap_pattern=0
mod1_source=0
mod1_destination=0
mod1_amount=0
mod2_source=0
mod2_destination=0
mod2_amount=0
feedback_lowpass_hz=12000
drift_amount=0.25
feedback_highpass_hz=80
lores_rate_end_hz=1200
